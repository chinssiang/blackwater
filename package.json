{
	"name": "blackwater",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"generate:groq": "node --experimental-strip-types --no-warnings scripts/generate-groq-constants.mjs",
		"prebuild": "npm run generate:groq",
		"predev": "npm run typegen",
		"dev": "next dev --port=3001 --turbopack",
		"build": "next build",
		"start": "next start",
		"typegen": "npm run generate:groq && sanity schema extract && sanity typegen generate",
		"start:web": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "git config core.hooksPath .githooks || exit 0"
	},
	"lint-staged": {
		"*.{ts,tsx,mts}": [
			"eslint --fix",
			"prettier --write"
		],
		"*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@hookform/resolvers": "^5.9.1",
		"@next/third-parties": "^16.3.5",
		"@portabletext/react": "^3.2.1",
		"@portabletext/types": "^4.0.0",
		"@sanity/client": "^7.26.2",
		"@sanity/color-input": "^4.0.3",
		"@sanity/document-internationalization": "^6.1.1",
		"@sanity/image-url": "^2.1.1",
		"@sanity/language-filter": "^5.0.1",
		"@sanity/rich-date-input": "^4.0.5",
		"@sanity/ui": "^3.0.6",
		"@sanity/vision": "^5.31.2",
		"@styled-jsx/plugin-sass": "^4.1.1",
		"@tanstack/react-query": "^5.67.3",
		"@vercel/analytics": "^1.6.1",
		"@vercel/speed-insights": "^1.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"embla-carousel": "^8.5.2",
		"embla-carousel-auto-height": "^8.5.2",
		"embla-carousel-autoplay": "^8.5.2",
		"embla-carousel-class-names": "^8.5.2",
		"embla-carousel-fade": "^8.5.2",
		"embla-carousel-react": "^8.6.0",
		"embla-carousel-wheel-gestures": "^8.0.1",
		"lucide-react": "^0.482.0",
		"motion": "^12.23.26",
		"next": "^16.3.3",
		"next-sanity": "^13.3.4",
		"next-themes": "^0.4.6",
		"nodemailer": "^7.0.10",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-hook-form": "^7.54.2",
		"react-icons": "^5.5.0",
		"react-intersection-observer": "^9.16.0",
		"react-is": "19.2.6",
		"rxjs": "^7.8.2",
		"sanitize-html": "^2.14.0",
		"sanity": "^5.31.2",
		"sanity-plugin-documents-pane": "^3.0.1",
		"sanity-plugin-iframe-pane": "^4.0.0",
		"sanity-plugin-internationalized-array": "^5.1.1",
		"sanity-plugin-media": "^4.0.0",
		"sanity-plugin-note-field": "^2.0.2",
		"sonner": "^2.0.6",
		"styled-components": "^6.1.19",
		"tailwind-merge": "^3.3.1",
		"tailwind-scrollbar": "^4.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.3.5",
		"@sanity/browserslist-config": "^1.0.5",
		"@swc/core": "^1.11.9",
		"@swc/plugin-styled-components": "^7.1.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"@types/sanitize-html": "^2.16.0",
		"autoprefixer": "^10.4.21",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "^17.12.0",
		"jsdom": "26.1.0",
		"lint-staged": "^17.5.1",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"server-only": "^0.0.1",
		"tailwindcss": "^4.1.11",
		"tw-animate-css": "^1.3.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	},
	"overrides": {
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3"
	}
}
