# Every environment variable the app and scripts read. Copy to `.env.local`
# and fill in; never commit real values. Shopify setup: docs/SHOPIFY-SETUP.md.

# --- Sanity (required) ---------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
# `dev` is authored in; `prod` is what the deployed site reads.
NEXT_PUBLIC_SANITY_DATASET=dev
# Optional; defaults to the version pinned in src/sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=
# Read-only. The app throws at startup without it (src/sanity/lib/live.ts).
SANITY_API_READ_TOKEN=
# Signs the Sanity webhook that hits /api/revalidate-tag.
SANITY_REVALIDATE_SECRET=

# --- Site (required) -----------------------------------------------------
# Absolute origin for the sitemaps, robots, emails and Klaviyo events.
SITE_URL=http://localhost:3001

# --- Members (sign-in at /account) ---------------------------------------
# Neon's connection string; the Vercel integration sets it for you. Apply
# schema changes with `npm run db:migrate` -- never run by the build.
DATABASE_URL=
# Signs session cookies. At least 32 random characters: `openssl rand -base64 32`.
# Changing it signs every member out.
BETTER_AUTH_SECRET=

# --- Email (contact form, product submission, sign-in codes) -------------
EMAIL_DISPLAY_NAME=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
# Defaults to Gmail SMTP on 465 when unset.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=

# --- Klaviyo (newsletter, back-in-stock) ---------------------------------
KLAVIYO_PRIVATE_API_KEY=

# --- Shopify (all optional: without them products render from Sanity) ----
# your-store.myshopify.com -- no https://, no trailing slash.
SHOPIFY_STORE_DOMAIN=
# Set ONE of the two; the private token wins when both are present.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Optional; defaults to the version pinned in src/lib/shopify/client.ts.
SHOPIFY_API_VERSION=

# --- One-shot scripts only (scripts/*.mjs) -- never read by the app -------
# Write access to the dataset. Keep it out of the deployed environment.
SANITY_READ_WRITE_TOKEN=
# Which dataset a script targets; scripts default to `dev`.
SANITY_DATASET=
