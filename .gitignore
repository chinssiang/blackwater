build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# next files
.next/

# Generated by Next on every dev/build, and NOT stable: `next dev` writes
# `./.next/dev/types/routes.d.ts` while `next build` writes
# `./.next/types/routes.d.ts`, so a tracked copy flips back and forth with
# whichever ran last and gets swept into unrelated commits (it moved in six of
# the last commits). Nothing here typechecks a fresh clone before a dev/build
# regenerates it, so ignoring it is free.
next-env.d.ts

# sanity dist
sanity/dist
public/sanity
*.tar*

# sanity schema
sanity/schema.js

# Mac files
.DS_Store
**/.DS_Store

# Yarn
yarn-error.log
yarn.lock
.pnp/
.pnp.js

# Yarn Integrity file
.yarn-integrity

# Secrets
.env*
.gstack/

# Generated by tsc --incremental; flaps on every build.
tsconfig.tsbuildinfo
